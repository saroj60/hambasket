{
    "build": {
        "rootDirectory": "backend",
        "watchPatterns": [
            "backend/**"
        ]
    },
    "deploy": {
        "startCommand": "node server.js",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    },
    "phases": {
        "setup": {
            "nixPkgs": [
                "nodejs-22_x"
            ]
        },
        "install": {
            "cmds": [
                "npm install"
            ]
        }
    }
}